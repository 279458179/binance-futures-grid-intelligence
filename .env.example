# Specifications only — names are proposed, not implemented.
APP_ENV=development
APP_TZ=UTC
BINANCE_FUTURES_API_BASE=https://fapi.binance.com
MARKET_SCAN_INTERVAL_MINUTES=15
MAX_CONCURRENT_MARKET_REQUESTS=4
MAX_MARKET_SYMBOLS_DEEP=100
MAX_DERIVATIVES_SYMBOLS=30
FUTURES_ONLY_READ_ONLY=true
DEFAULT_PLAN_VALID_MINUTES=240
DATABASE_URL=sqlite:////data/market.db
APP_PUBLIC_URL=http://localhost:3000
# Set sensitive AUTH_SECRET/ALERT_ tokens only in a private secrets store.